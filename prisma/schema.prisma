datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  nomor String @unique
  name String
  token Int
  saldo Int @default(0)
  free_event Boolean @default(true)
  payments Payment[]
  @@map("users")
}

model Payment {
  id Int @id @default(autoincrement())
  user_id        String
  user           User     @relation(fields: [user_id], references: [nomor], onDelete: Cascade)
  payment_number String
  amount Int
  status String
  fee Int
  total_payment Int
  payment_method String
  order_id String @unique
  product_buy String
  product_price Int
  product_quantity Int
  msg_id String
  expired_at DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("payments")
}

model ApiKey {
  id String @unique
  key String
  owner String
  token Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("api_keys")
}

model Project {
  id              String         @id @default(cuid())
  name            String
  api_key         String         @unique
  webhook_url     String?
  webhook_secret  String
  reply_mode      String         @default("none") // respon bot ke user: none | reaction | message
  success_message String?        // dipakai kalau reply_mode = message (null = default)
  expires_in      Int            @default(300) // detik, default kalau request tidak mengirim expires_in
  active          Boolean        @default(true)
  sandbox         Boolean        @default(false) // true = boleh simulasi verifikasi tanpa WhatsApp (untuk development)
  verifications   Verification[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@map("projects")
}

model Verification {
  id             String    @id @default(cuid())
  project_id     String
  project        Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  code           String    @unique
  token          String    @unique // acak, untuk link halaman publik /verify/<token>
  phone          String?   // kalau diisi, nomor pengirim wajib sama
  verified_phone String?
  reference      String?
  status         String    @default("pending") // pending | verified (expired dihitung dari expires_at)
  expires_at     DateTime
  verified_at    DateTime?
  webhook_status String?   // sent | failed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([project_id, createdAt])
  @@map("verifications")
}
