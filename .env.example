# Server
PORT=3000
# URL publik server (untuk link halaman verifikasi /verify/...), misal https://wa.domain.com
PUBLIC_URL=

# Master key untuk endpoint /api/* dan login dashboard /admin
API_KEY=

# Nomor owner bot (format 62...), default di src/utils/messages.js
OWNER_NUMBER=

# Payment gateway Pakasir (QRIS)
PAKASIR_SLUG=
PAKASIR_API_KEY=

# Integrasi fitur
REMOVEBG_API_KEY=
DISCORD_WEBHOOK_ANNOUC=
PASS_ADMIN=
API_KEY_SHORTLINK=
API_KEY_SHORTLINKPOLIBATAM=

# Opsional: override lokasi database (default: prisma/dev.db)
# DATABASE_URL=file:./dev.db
